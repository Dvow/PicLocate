#include <windows.h>
1 ICON "@PICLOCATE_ICON@"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "PicLocate contributors\0"
   VALUE "FileDescription", "PicLocate - Local Image Search\0"
   VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
   VALUE "InternalName", "PicLocate\0"
   VALUE "LegalCopyright", "Copyright 2026 PicLocate contributors\0"
   VALUE "OriginalFilename", "PicLocate.exe\0"
   VALUE "ProductName", "PicLocate\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
