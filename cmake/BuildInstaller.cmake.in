# This is a dedicated generated staging directory, never an existing user install.
file(REAL_PATH "@CMAKE_BINARY_DIR@" _build_root)
set(_stage "${_build_root}/installer-stage")
if(EXISTS "${_stage}")
  file(REAL_PATH "${_stage}" _resolved_stage)
  if(NOT _resolved_stage STREQUAL _stage OR NOT EXISTS "${_stage}/.piclocate-installer-stage")
    message(FATAL_ERROR "Refusing to clear an unrecognized installer staging directory: ${_stage}")
  endif()
  file(REMOVE_RECURSE "${_stage}")
endif()
file(MAKE_DIRECTORY "${_stage}")
file(WRITE "${_stage}/.piclocate-installer-stage" "Owned by PicLocate's setup target.\n")
execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@"
  --config "${PICLOCATE_SETUP_CONFIG}" --prefix "${_stage}" COMMAND_ERROR_IS_FATAL ANY)
foreach(_required PicLocate.exe Qt6Core.dll Qt6Gui.dll Qt6Widgets.dll onnxruntime.dll
    qt.conf plugins/platforms/qwindows.dll plugins/sqldrivers/qsqlite.dll LICENSE)
  if(NOT EXISTS "${_stage}/${_required}")
    message(FATAL_ERROR "Incomplete installer payload: ${_required}")
  endif()
endforeach()
if(@PICLOCATE_BUNDLE_MODELS@)
  foreach(_model tokenizer.json text_model_quantized.onnx vision_model_quantized.onnx vision_model_fp16.onnx)
    if(NOT EXISTS "${_stage}/models/${_model}")
      message(FATAL_ERROR "Missing bundled model: ${_model}")
    endif()
  endforeach()
endif()
file(GLOB_RECURSE _payload RELATIVE "${_stage}" "${_stage}/*")
foreach(_file IN LISTS _payload)
  if(_file MATCHES "\\.sqlite($|-)" OR _file MATCHES "(^|/)settings\\.ini$" OR _file MATCHES "(^|/)thumbnails/")
    message(FATAL_ERROR "User data must never enter an installer: ${_file}")
  endif()
endforeach()
execute_process(COMMAND "@PICLOCATE_ISCC@" /Qp "@CMAKE_BINARY_DIR@/PicLocate.iss"
  COMMAND_ERROR_IS_FATAL ANY)
set(_output "@PICLOCATE_INSTALLER_OUTPUT_DIR@/@PICLOCATE_SETUP_BASENAME@.exe")
file(SHA256 "${_output}" _sha)
file(WRITE "${_output}.sha256" "${_sha}  @PICLOCATE_SETUP_BASENAME@.exe\n")
message(STATUS "Setup ready: ${_output}")
